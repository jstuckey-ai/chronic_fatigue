<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = seoTitle or title -%}
  <title>{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta name="robots" content="{% if page.url == '/search/' or page.url == '/404.html' %}noindex, follow{% else %}index, follow, max-snippet:-1, max-image-preview:large{% endif %}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="text/plain" title="LLM-friendly site guide" href="{{ site.url }}/llms.txt">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
  <meta property="og:locale" content="en_AU">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="chronicfatigue.support: clear, honest information about ME/CFS">
  {% if page.url != '/' %}<meta property="article:modified_time" content="{{ (reviewed or site.lastReviewed) | isoDate }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or site.name }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/og.png">
  {% if page.url != '/404.html' and page.url != '/search/' %}{% structuredData page.url, title, seoTitle, description, reviewed, schemaType %}{% endif %}
  <meta name="theme-color" content="#fbf7f1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <script>
    // Apply saved reading-comfort settings before first paint to avoid a flash.
    (function () {
      try {
        var t = localStorage.getItem("cfs-theme"); if (t) document.documentElement.dataset.theme = t;
        var s = localStorage.getItem("cfs-size"); if (s) document.documentElement.dataset.size = s;
        if (localStorage.getItem("cfs-calm") === "1") document.documentElement.dataset.calm = "1";
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {% block main %}{{ content | safe }}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
